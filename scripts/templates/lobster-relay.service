[Unit]
Description=lobster-cc self-hosted WeCom relay
After=network.target

[Service]
Type=simple
User=lobster-relay
Group=lobster-relay
# Secrets (RELAY_FETCH_TOKEN, WECOM_TOKEN, WECOM_AES_KEY, AGENT_CONFIGS_B64) live
# in this 0600 file owned by lobster-relay — NOT inline here (the unit file is
# world-readable). Non-secret tunables stay inline below.
EnvironmentFile=/etc/lobster-relay/relay.env
Environment=RELAY_DB_PATH=/var/lib/lobster-relay/relay.db
Environment=RELAY_PORT=__RELAY_PORT__
Environment=PYTHONPATH=/opt/lobster-relay
Environment=TTL_DAYS=2
Environment=FRESHNESS_SECONDS=300
# Runs from a dedicated venv at /opt/lobster-relay/.venv (deps installed there by
# setup-self-relay.sh) — avoids depending on system pip / system site-packages.
ExecStart=/opt/lobster-relay/.venv/bin/python -m remote_control.relay
WorkingDirectory=/opt/lobster-relay
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
